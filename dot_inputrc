# show completions on first tab, cycle on subsequent tabs

set show-all-if-ambiguous on

set menu-complete-display-prefix on

TAB: menu-complete

"\e[Z": menu-complete-backward


set show-all-if-unmodified on

set colored-stats on
set colored-completion-prefix on

set bell-style none

# handy for editing existing commands
# will identify/use existing text after the cursor if it is the same as the tab match
set skip-completed-text on
