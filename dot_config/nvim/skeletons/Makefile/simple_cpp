cxx = g++
cxxflags = -std=c++20 -D_GNU_SOURCE -O3 -march=native -Wall -Wextra -MMD -MP

progs = $(basename $(wildcard *.cpp))

all: $(progs)

%: %.cpp
	$(cxx) $(cxxflags) $< -o $@

%.s: %.cpp
	$(cxx) $(cxxflags) -S -fverbose-asm $< -o $@

%.run: % FORCE
	@./$<

%.perf: % FORCE
	perf stat ./$<

FORCE:

clean:
	rm -f $(progs) *.d *.s

.PHONY: all clean FORCE

-include $(progs:=.d)
