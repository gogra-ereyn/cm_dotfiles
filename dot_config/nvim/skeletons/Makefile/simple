cc = gcc
cflags = -std=c99 -D_GNU_SOURCE -O3 -march=native -Wall -Wextra -MMD -MP

BUILD = build
srcs = $(wildcard *.c)
progs = $(addprefix $(BUILD)/, $(basename $(srcs)))

all: $(progs)

$(BUILD)/%: %.c | $(BUILD)
	$(cc) $(cflags) $< -o $@ -MF $@.d

$(BUILD)/%.s: %.c | $(BUILD)
	$(cc) $(cflags) -S -fverbose-asm $< -o $@

%.run: $(BUILD)/% FORCE
	@./$<

%.perf: $(BUILD)/% FORCE
	perf stat ./$<

FORCE:

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all clean FORCE

-include $(progs:=.d)
