.DEFAULT_GOAL := all

CC = gcc
CPPFLAGS = -D_GNU_SOURCE
CFLAGS = -std=c99 -g -O3 -march=native -Wall -Wextra
LDFLAGS =
LDLIBS =

BUILD = build
SRCS = $(wildcard *.c)
PROGS = $(addprefix $(BUILD)/, $(basename $(SRCS)))
COMPDB = $(BUILD)/compile_commands.json

all: $(PROGS) $(COMPDB)

$(BUILD)/%: %.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -MF $@.d $< -o $@ $(LDFLAGS) $(LDLIBS)

$(COMPDB): FORCE | $(BUILD)
	@{ \
		printf '[\n'; \
		sep=''; \
		for f in $(SRCS); do \
			printf '%s  {"directory": "%s", "file": "%s", "command": "%s"}\n' \
				"$$sep" "$(CURDIR)" "$$f" \
				"$(CC) $(CPPFLAGS) $(CFLAGS) -c $$f -o $(BUILD)/$${f%.c}.o"; \
			sep=,; \
		done; \
		printf ']\n'; \
	} > $@.tmp
	@cmp -s $@.tmp $@ && rm $@.tmp || mv $@.tmp $@

$(BUILD)/%.s: %.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -S -fverbose-asm $< -o $@

%.run: $(BUILD)/% FORCE
	@./$<

%.perf: $(BUILD)/% FORCE
	perf stat ./$<

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

FORCE:

.PHONY: all clean FORCE

-include $(PROGS:=.d)

