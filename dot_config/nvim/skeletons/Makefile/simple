cc = gcc
cflags = -std=c99 -D_GNU_SOURCE -O3 -march=native -Wall -Wextra -MMD -MP

progs = $(basename $(wildcard *.c))

all: $(progs)

%: %.c
	$(cc) $(cflags) $< -o $@

%.s: %.c
	$(cc) $(cflags) -S -fverbose-asm $< -o $@

%.run: % FORCE
	@./$<

%.perf: % FORCE
	perf stat ./$<

FORCE:

clean:
	rm -f $(progs) *.d *.s

.PHONY: all clean FORCE

-include $(progs:=.d)
