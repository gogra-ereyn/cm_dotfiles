#!/bin/bash
set -euo pipefail

# for debugging:
# check ssh:
#   ssh -G github.com-cutils-ro | grep -Ei '^(user|hostname|identityfile|identitiesonly) '
# to override:
#   ssh -o IdentitiesOnly=yes -i ~/.ssh/github-cutils-deploy -T git@github.com
# so in ordr:
# ssh -G github.com-cutils-ro | grep -Ei '^(user|hostname|identityfile|identitiesonly) '
# ssh -Tv git@github.com-cutils-ro
# ssh -o IdentitiesOnly=yes -i ~/.ssh/github-cutils-deploy -T git@github.com

main() {
    local cache_dir="${HOME}/.cache/cutils-src"
    local local="{{ dig "cutils" "local" "" . }}"
    local remote="{{ dig "cutils" "remote" "git@github.com-cutils-ro:gogra-ereyn/cutils.git" . }}"
    local ref="{{ dig "cutils" "ref" "master" . }}"
    local src=

    if [[ -n "$local" && -d "$local" ]]; then
        src="$local"
    else
        src="$cache_dir"
        if [[ -d "$src/.git" ]]; then
            git -C "$src" fetch origin
        else
            git clone "$remote" "$src"
        fi
        git -C "$src" checkout "$ref"
        git -C "$src" merge --ff-only "origin/$ref" 2>/dev/null || true
    fi

    cmake -B "$src/build" -S "$src" -DCMAKE_BUILD_TYPE=RelWithDebInfo -DBUILD_TESTING=OFF
    cmake --build "$src/build"
    cmake --install "$src/build"
}

main "$@"
